# LARAXOT THEME: TwentyOne — .gitignore
# Organizzato per sezione (STORY-491).
# Nessuna copertura persa rispetto alla versione precedente: i duplicati esatti
# (`node_modules` x3, `vendor` x2) sono stati unificati in una sola entry.
# `vendor` e `/vendor/` NON sono equivalenti in gitignore: il primo matcha a ogni
# livello, il secondo solo alla root. Entrambi sono tenuti deliberatamente.

# --- Dependencies & packages ---
# vendor a ogni livello (sotto-root) …
vendor
# … e alla root esplicitamente.
/vendor/
node_modules/
dist-ssr

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Laravel runtime ---
bootstrap/compiled.php
app/storage/
storage/*.key
public/storage
public/hot
public_html/storage
public_html/hot
/.vagrant
Homestead.json
Homestead.yaml

# --- Generated & cache ---
.phpunit.result.cache
.git-blame-ignore-revs
build/
cache/
logs

# --- Logs ---
*.log
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
agentdb.rvf

# --- Copy / backup / old files ---
*.old
*.old1
*.bak
*.bakcup
*.backup
*.backup.*
* copy
* copy.*
# `* copy/` è ridondante: in gitignore `* copy` matcha già la directory omonima.
*.local

# --- Merge / rebase / editor leftovers (mai committare — es. `.agent~HEAD`) ---
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*~head
*.orig
*.rej
*.sw?
*.swo

# --- IDE (conservare solo le impostazioni condivise) ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# --- Legacy MSVS/foreign IDE (ereditati dal .gitignore Laravel 5, tenuti per non
# --- perdere copertura; irrelevanti per un tema PHP ma innocui) ---
*.suo
*.ntvs*
*.njsproj
*.sln

# --- AI/TOOL SCAFFOLD — must never exist in the theme tree ---
.cursor/
.devcontainer/
.windsurf/
graphify-out/
_bmad-output
.claude/
.claude-audit

# --- Quality tool configs (vietati alla root di modulo/tema) ---
/phpinsights.php
/rector.php
phpunit.xml
phpunit.xml.dist
testbench.yaml
test-results

# --- AuditCoverage: bridge di audit generati, mai tracciati ---
# Generati da claude-audit / AuditBridgeTest, mai sorgente del tema.
# Percorso con slash finale per coprire il contenuto della cartella.
tests/AuditCoverage/
tests/.claude-audit
audit-coverage/

# --- Second brain: no-docs-archive (legacy docs/archive/) ---
docs/archive/
docs/**/archive/
docs/archived/
docs/**/archived/
_docs/
